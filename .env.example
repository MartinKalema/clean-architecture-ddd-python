# Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging
LOG_FORMAT=json  # json or standard
LOG_LEVEL=INFO   # DEBUG, INFO, WARNING, ERROR

# Database
DATABASE_URL=sqlite:///./books.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/library

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=domain_events

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=admin@library.com
SENDGRID_ADMIN_EMAIL=admin@library.com

# Templates
TEMPLATES_DIR=src/infrastructure/templates
