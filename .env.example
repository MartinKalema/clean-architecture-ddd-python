# Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Database - optimized for load testing
# For local development (direct postgres):
DATABASE_URL=postgresql+asyncpg://library:library_secret@localhost:5432/library_db
# For Docker (via pgbouncer):
# DATABASE_URL=postgresql+asyncpg://library:library_secret@pgbouncer:6432/library_db
DATABASE_POOL_SIZE=100
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=domain_events

# SendGrid
SENDGRID_API_KEY=SG.placeholder
SENDGRID_FROM_EMAIL=admin@library.com
SENDGRID_ADMIN_EMAIL=admin@library.com

# Templates
TEMPLATES_DIR=src/infrastructure/templates

# etcd
ETCD_HOST=localhost
ETCD_PORT=2379
ETCD_CONFIG_PREFIX=/config/

# Circuit Breakers - RabbitMQ
CB_RABBITMQ_NAME=rabbitmq
CB_RABBITMQ_FAILURE_THRESHOLD=5
CB_RABBITMQ_SUCCESS_THRESHOLD=2
CB_RABBITMQ_TIMEOUT=30.0

# Circuit Breakers - SendGrid
CB_SENDGRID_NAME=sendgrid
CB_SENDGRID_FAILURE_THRESHOLD=3
CB_SENDGRID_SUCCESS_THRESHOLD=2
CB_SENDGRID_TIMEOUT=60.0

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300
REDIS_ENABLED=true
