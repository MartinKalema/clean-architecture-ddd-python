# Docker Environment Configuration
# Used by docker-compose for containerized deployment

ENVIRONMENT=production

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Database - via pgbouncer for connection pooling
DATABASE_URL=postgresql+asyncpg://library:library_secret@pgbouncer:6432/library_db
DATABASE_API_POOL_SIZE=20
DATABASE_API_MAX_OVERFLOW=10
DATABASE_WORKFLOW_POOL_SIZE=5
DATABASE_WORKFLOW_MAX_OVERFLOW=5
DATABASE_NOTIFICATION_POOL_SIZE=3
DATABASE_NOTIFICATION_MAX_OVERFLOW=2
DATABASE_REAPER_POOL_SIZE=2
DATABASE_REAPER_MAX_OVERFLOW=0
DATABASE_PROJECTION_POOL_SIZE=2
DATABASE_PROJECTION_MAX_OVERFLOW=0
DATABASE_CLI_POOL_SIZE=2
DATABASE_CLI_MAX_OVERFLOW=0
DATABASE_MAINTENANCE_POOL_SIZE=5
DATABASE_MAINTENANCE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# SendGrid
SENDGRID_API_KEY=SG.placeholder
SENDGRID_FROM_EMAIL=admin@library.com
SENDGRID_REQUEST_TIMEOUT_SECONDS=15

# etcd
ETCD_HOST=etcd
ETCD_PORT=2379
ETCD_CONFIG_PREFIX=/config/

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300
REDIS_ENABLED=true

# Circuit Breakers - SendGrid
CB_SENDGRID_NAME=sendgrid
CB_SENDGRID_FAILURE_THRESHOLD=3
CB_SENDGRID_SUCCESS_THRESHOLD=2
CB_SENDGRID_TIMEOUT=60.0

# Kafka (CDC Pipeline)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PROJECTION_GROUP_ID=es-sync-consumer
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=1.0
KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=900000
KAFKA_MESSAGE_PROCESSING_TIMEOUT_SECONDS=180
# The bundled development topology has one broker. Real deployments must use 3+.
KAFKA_INTERNAL_TOPIC_REPLICATION_FACTOR=1
KAFKA_WORKFLOW_GROUP_ID=domain-workflow-worker-v1
KAFKA_NOTIFICATION_GROUP_ID=domain-notification-worker-v1

# Elasticsearch (CDC Pipeline)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_MAX_CONNECTIONS=300
ELASTICSEARCH_REQUEST_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# Transactional outbox retention
DEBEZIUM_OUTBOX_SLOT_NAME=library_outbox_slot
OUTBOX_RETENTION_HOURS=2160
OUTBOX_MAX_SLOT_LAG_BYTES=1073741824
OUTBOX_CLEANUP_BATCH_SIZE=500
OUTBOX_CLEANUP_MAX_BATCHES=20
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600
COMMAND_RECEIPT_RETENTION_DAYS=30
TERMINAL_OPERATION_RETENTION_DAYS=120
PROCESSED_INBOX_RETENTION_DAYS=120
EVENT_QUARANTINE_RETENTION_DAYS=365
DURABLE_STATE_CLEANUP_BATCH_SIZE=500
DURABLE_STATE_CLEANUP_MAX_BATCHES=20
DURABLE_STATE_CLEANUP_INTERVAL_SECONDS=86400
